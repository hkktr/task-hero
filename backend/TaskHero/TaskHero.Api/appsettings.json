{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {},
  "Storage": {
    "AzureStorageUri": "https://taskherostorage.blob.core.windows.net/",
    "Containers": {
      "Images": {
        "Name": "images"
      }
    }
  },
  "ImageUpload": {
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png"
